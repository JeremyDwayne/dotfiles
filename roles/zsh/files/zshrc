# ZSH_THEME="robbyrussell"
# ZSH_THEME="powerlevel10k/powerlevel10k"
BAT_THEME="Dracula"
DELTA_THEME="Dracula"

export EDITOR='nvim'
export SUDO_EDITOR='nvim'

# zsh essentials
HISTFILE="$HOME/.histfile"             # Save 100000 lines of history
HISTSIZE=100000
SAVEHIST=100000
setopt BANG_HIST                 # Treat the '!' character specially during expansion.
setopt EXTENDED_HISTORY          # Write the history file in the ":start:elapsed;command" format.
setopt INC_APPEND_HISTORY        # Write to the history file immediately, not when the shell exits.
setopt SHARE_HISTORY             # Share history between all sessions.
setopt HIST_IGNORE_DUPS          # Don't record an entry that was just recorded again.
setopt HIST_IGNORE_ALL_DUPS      # Delete old recorded entry if new entry is a duplicate.
setopt HIST_IGNORE_SPACE         # Don't record an entry starting with a space.

# Load custom config files and aliases
for file in $HOME/.config/zsh/*.zsh; do
  source "$file"
done

# PATH
export NVM_DIR="$HOME/.nvm"
  [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"  # This loads nvm
  [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

# bun completions
[ -s "/Users/jwinterberg/.bun/_bun" ] && source "/Users/jwinterberg/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH=$HOME/.local/bin:$HOME/go/bin:$HOME/.cargo/bin:$BUN_INSTALL/bin:$PATH
export PATH=$HOME/.console-ninja/.bin:/opt/homebrew/opt/postgresql@16/bin:$PATH

# pnpm
export PNPM_HOME="/Users/jwinterberg/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# AI Tools
export PROVIDER="ollama"
export MODEL="mistral"
export PATH="/Users/jwinterberg/.config/herd-lite/bin:$PATH"
export PHP_INI_SCAN_DIR="/Users/jwinterberg/.config/herd-lite/bin:$PHP_INI_SCAN_DIR"
export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"

eval "$(mise activate zsh)"

. "$HOME/.turso/env"

# claudex — Claude Code on GPT-5.6 (Sol/Terra/Luna) via local CLIProxyAPI (Codex OAuth).
# Starts in a new git worktree by default; run plain `claude` to skip the proxy/worktree.
claudex() {
  if ! nc -z 127.0.0.1 8317 2>/dev/null; then
    echo "claudex: starting cliproxyapi service..." >&2
    brew services start cliproxyapi >/dev/null
    sleep 2
  fi
  ANTHROPIC_BASE_URL="http://127.0.0.1:8317" \
  ANTHROPIC_AUTH_TOKEN="$(<"$HOME/.cli-proxy-api/client.key")" \
  ANTHROPIC_MODEL="gpt-5.6-sol" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="gpt-5.6-sol" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="gpt-5.6-terra" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="gpt-5.6-luna" \
  ANTHROPIC_SMALL_FAST_MODEL="gpt-5.6-luna" \
  claude "$@" --worktree
}
