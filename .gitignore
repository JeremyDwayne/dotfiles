.DS_Store
Brewfile.lock.json
!bin
nvim/bundle/*
nvim/plugged/*
nvim/autoload/*
nvim/pack/*
env_vars.zsh
local/share/*
nvim/plugin
tmux-client*.log
__pycache__
roles/tmux/files/tmux/plugins
roles/neovim/files/lazy-lock.json

# environment variables
roles/zsh/files/zsh/env.zsh

# Karabiner writes backups and assets next to karabiner.json
roles/karabiner/files/*
!roles/karabiner/files/karabiner.json
