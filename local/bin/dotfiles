#!/bin/bash

# color codes
NC='\033[0m'
GREEN='\033[00;32m'
CYAN='\033[00;36m'
SEA="\\033[38;5;49m"
LBLACK='\033[01;30m'
LRED='\033[01;31m'
LGREEN='\033[01;32m'
OVERWRITE='\e[1A\e[K'

#emoji codes
CHECK_MARK="${GREEN}\xE2\x9C\x94${NC}"
ARROW="${SEA}\xE2\x96\xB6${NC}"

DOTFILES_LOG="$HOME/.dotfiles.log"

# _header colorize the given argument with spacing
function _task {
  # if _task is called while a task was set, complete the previous
  if [[ $TASK != "" ]]; then
    printf "${OVERWRITE}${LGREEN} [✓]  ${LGREEN}${TASK}\n"
  fi
  # set new task title and print
  TASK=$1
  printf "${LBLACK} [ ]  ${TASK} \n${LRED}"
}

# _cmd performs commands with error checking
function _cmd {
  # hide stdout, on error we print and exit
  if eval "$1" 1>/dev/null 2>"$DOTFILES_LOG"; then
    return 0 # success
  fi
  # read error from log and add spacing
  printf "${OVERWRITE}${LRED} [X]  ${TASK}${LRED}\n"
  while read line; do
    printf "      ${line}\n"
  done <$DOTFILES_LOG
  printf "\n"
  # remove log file
  rm $DOTFILES_LOG
  # exit installation
  exit 1
}

function _clear_task {
  TASK=""
}

function _task_done {
  printf "${OVERWRITE}${LGREEN} [✓]  ${LGREEN}${TASK}\n"
  _clear_task
}

set -e

# Paths
VAULT_SECRET="$HOME/.ansible-vault/vault.secret"
DOTFILES_DIR="$HOME/.dotfiles"
IS_FIRST_RUN="$HOME/.dotfiles_run"

function mac_setup() {
  if ! [[ -x /opt/homebrew/bin/brew ]]; then
    _task "Installing Homebrew"
    # Runs in the foreground: the installer asks for sudo and a keypress.
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi
  eval "$(/opt/homebrew/bin/brew shellenv)"
  if ! command -v ansible >/dev/null; then
    _task "Installing Ansible"
    _cmd "brew install ansible"
  fi
}

_task "Loading Setup for detected OS: $OSTYPE"
case $OSTYPE in
darwin*)
  mac_setup
  ;;
*)
  printf "${OVERWRITE}${LRED} [X]  Unsupported OS: $OSTYPE${NC}\n"
  exit 1
  ;;
esac

if ! [[ -d "$DOTFILES_DIR" ]]; then
  _task "Cloning repository"
  _cmd "git clone --quiet https://github.com/JeremyDwayne/dotfiles.git $DOTFILES_DIR"
else
  _task "Updating repository"
  _cmd "git -C $DOTFILES_DIR pull --quiet"
fi

# .local/bin symlinks
_task "Symlinking ~/.local/bin Scripts"
_cmd 'mkdir -p ~/.local/bin && ln -sf "$DOTFILES_DIR"/local/bin/* ~/.local/bin/'

pushd "$DOTFILES_DIR" >/dev/null 2>&1
_task "Updating Ansible Galaxy collections"
_cmd "ansible-galaxy collection install --upgrade -r $DOTFILES_DIR/requirements/common.yml"

_task "Running playbook"
_task_done
if [[ -f $VAULT_SECRET ]]; then
  ansible-playbook --vault-password-file $VAULT_SECRET "$DOTFILES_DIR/main.yml" "$@"
else
  ansible-playbook "$DOTFILES_DIR/main.yml" "$@"
fi

popd >/dev/null 2>&1

if ! [[ -f "$IS_FIRST_RUN" ]]; then
  echo -e "${CHECK_MARK} ${GREEN}First run complete!${NC}"
  echo -e "${ARROW} ${CYAN}Please reboot your computer to complete the setup.${NC}"
  touch "$IS_FIRST_RUN"
fi

# vi:ft=sh:
